# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/messenger_automation

# --- Panel admin (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=super-secret-change-me

# --- API HTTP (token independiente de las credenciales del panel) ---
MESSENGER_API_TOKEN=change-me

# --- Playwright / Navegador ---
MESSENGER_BROWSER_PROFILE=./data/messenger-profile
MESSENGER_HEADLESS=false
MESSENGER_SLOW_MS=0
MESSENGER_AUTOCONNECT=true

# --- Scheduler ---
MESSENGER_TIMEZONE=Asia/Bangkok
SCHEDULER_ENABLED=true

# --- Límites ---
MESSAGE_MAX_LENGTH=4000
SEND_TIMEOUT_MS=60000
